{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fixmypc.local/schemas/diagnostic.schema.json",
  "title": "FIX MY PC diagnostic document (sanitized and internal share this shape)",
  "description": "Versioned diagnostic document produced by fixmypc.ps1. The sanitized variant masks event messages, command lines, account identifiers and paths. Some inventory names remain for diagnosis.",
  "type": "object",
  "required": ["schemaVersion", "run"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "run": {
      "type": "object",
      "required": ["id", "toolVersion", "mode", "language", "synthetic", "startedAt", "finishedAt"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "toolVersion": { "type": "string" },
        "mode": { "enum": ["simple", "full"] },
        "symptom": { "enum": ["general", "boot", "slow", "crash"], "description": "2.0 (optional): problem the person asked to investigate." },
        "duringProblem": { "enum": ["yes", "no", "unknown"], "description": "2.0 (optional): whether the problem was happening during the measurement, as stated by the person." },
        "observeSeconds": { "type": "integer", "minimum": 0, "maximum": 300, "description": "2.0 (optional): requested observation window; 0 in the Quick audit." },
        "incident": {
          "type": "object",
          "additionalProperties": true,
          "description": "Phase A (optional): structured time of the reported problem. Absent when unknown.",
          "properties": {
            "kind": { "enum": ["unknown", "during_run", "at"] },
            "input": { "type": "string" },
            "atUtc": { "type": "string", "format": "date-time" },
            "toleranceMinutes": { "type": "integer", "minimum": 1, "maximum": 720 },
            "effectiveToleranceMinutes": { "type": "integer", "minimum": 1, "maximum": 780 },
            "offsetKnown": { "type": "boolean" },
            "ambiguousLocal": { "type": "boolean" }
          }
        },
        "depth": { "enum": ["standard", "deep"], "description": "Phases B/C (optional, Full audit): how far complementary investigations were authorized." },
        "language": { "enum": ["pt-BR", "en"] },
        "synthetic": { "type": "boolean" },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "readOnlyPolicy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "readOnly": { "type": "boolean" },
            "collectionWrites": { "type": "boolean" },
            "networkAccess": { "type": "boolean" },
            "elevation": { "type": "boolean" }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "description": "OS, build, CPU, memory, GPU, disks, volumes, uptime. Never contains serials, product keys or machine GUIDs.",
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "caption": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "buildNumber": { "type": ["string", "null"] },
            "displayVersion": { "type": ["string", "null"] },
            "ubr": { "type": ["integer", "null"] },
            "architecture": { "type": ["string", "null"] },
            "uptimeHours": { "type": ["number", "null"] }
          }
        },
        "cpu": { "type": ["object", "null"], "additionalProperties": true },
        "memory": { "type": ["object", "null"], "additionalProperties": true },
        "gpu": { "type": "array", "items": { "type": "object" } },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "description": "Model, size, status, interface. No serialNumber field by policy."
          }
        },
        "volumes": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "windowDays": { "type": "integer" },
        "catalog": {
          "type": "object",
          "additionalProperties": true,
          "description": "Phase A, Full audit: closed diagnostic catalog of System events. Each entry is one provider + ID pair; occurrences hold only time and level, never message text.",
          "properties": {
            "version": { "type": "string" },
            "state": { "enum": ["pass", "unknown", "error"] },
            "channel": { "const": "System" },
            "windowDays": { "type": "integer", "minimum": 1, "maximum": 60 },
            "since": { "type": "string", "format": "date-time" },
            "maxPerProvider": { "type": "integer", "minimum": 1, "maximum": 500 },
            "anyTruncated": { "type": "boolean" },
            "retention": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "status": { "enum": ["ok", "empty", "access_denied", "unsupported", "error"] },
                "oldestAt": { "type": ["string", "null"], "format": "date-time" },
                "coversWindow": { "type": ["boolean", "null"] }
              }
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["key", "provider", "eventId", "family", "status", "count"],
                "properties": {
                  "key": { "type": "string" },
                  "provider": { "type": "string" },
                  "eventId": { "type": "integer" },
                  "family": { "enum": ["graphics", "storage", "network", "lifecycle", "clock"] },
                  "meaning": { "type": "string" },
                  "status": { "enum": ["ok", "empty", "provider_absent", "access_denied", "unsupported", "error"] },
                  "count": { "type": "integer", "minimum": 0 },
                  "truncated": { "type": "boolean" },
                  "distinctDays": { "type": "integer", "minimum": 0 },
                  "firstSeen": { "type": ["string", "null"], "format": "date-time" },
                  "lastSeen": { "type": ["string", "null"], "format": "date-time" },
                  "occurrences": { "type": "array", "maxItems": 60, "items": { "type": "object", "additionalProperties": true } }
                }
              }
            }
          }
        },
        "logs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "status": { "enum": ["ok", "empty", "access_denied", "error", "unsupported"] },
              "totalEvents": { "type": ["integer", "null"] },
              "truncated": { "type": "boolean" },
              "collectionTruncated": { "type": ["boolean", "null"] },
              "sanitizedTruncated": { "type": ["boolean", "null"] },
              "presentedCount": { "type": ["integer", "null"] },
              "groups": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "provider": { "type": ["string", "null"] },
                    "eventId": { "type": ["integer", "null"] },
                    "count": { "type": ["integer", "null"] },
                    "firstSeen": { "type": ["string", "null"], "format": "date-time" },
                    "lastSeen": { "type": ["string", "null"], "format": "date-time" },
                    "sample": { "type": ["string", "null"], "description": "Legacy fixture field. Live event messages are omitted." },
                    "msgMissing": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "kind": { "enum": ["run", "runOnce", "folder"] },
              "name": { "type": ["string", "null"] },
              "command": { "type": ["string", "null"], "description": "Metadata only; never executed." },
              "source": { "type": ["string", "null"] },
              "view": { "type": ["string", "null"] },
              "origin": { "type": ["string", "null"] }
            }
          }
        },
        "logonTasks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "autoServices": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "memory": { "type": ["object", "null"], "additionalProperties": true },
        "cpu": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "sampleCount": { "type": ["integer", "null"] },
            "avgPercent": { "type": ["number", "null"] },
            "samples": { "type": "array", "items": { "type": "object" } }
          }
        },
        "topProcessesByMemory": { "type": ["array", "null"], "items": { "type": "object" } },
        "topProcessesByCpu": { "type": ["array", "null"], "items": { "type": "object" } },
        "pagefile": { "type": ["object", "null"], "additionalProperties": true }
      }
    },
    "storage": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "volumes": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "physicalDisks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "smart": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "status": { "enum": ["ok", "empty", "access_denied", "unsupported", "error"] },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "predictFailure": { "type": ["boolean", "null"] },
                  "reason": { "type": ["integer", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": true,
      "description": "2.0, Full audit only: CPU, memory, physical disk and per-process figures computed from raw CIM perf counter deltas over a bounded window. Process names only. Each family has a state (pass/unknown/access_denied/unsupported/error).",
      "properties": {
        "requestedSec": { "type": "integer" },
        "intervalSec": { "type": "integer" },
        "actualSec": { "type": ["number", "null"] },
        "intervals": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "cpu": { "type": "object", "additionalProperties": true },
        "memory": { "type": "object", "additionalProperties": true },
        "disks": { "type": "object", "additionalProperties": true },
        "processes": {
          "type": "object",
          "additionalProperties": true,
          "description": "privateMB is the legacy name of the private WORKING SET (resident) and keeps that meaning; workingSetPrivateMB is the same value under its explicit name. commitPrivateMB is Private Bytes (committed). Read/write rates are deltas over the observed window and include file, network and device I/O. appGroups group by executable name, which does not prove one application; never add them to the per-process rows.",
          "properties": {
            "topCommit": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            "topIo": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            "appGroups": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            "appGroupBasis": { "const": "executable_name" },
            "exitedDuringWindow": { "type": "integer", "minimum": 0 },
            "ioInvalidIntervals": { "type": "integer", "minimum": 0 }
          }
        },
        "cost": { "type": "object", "additionalProperties": true }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": true,
      "description": "2.0: deterministic symptom-oriented questions (src/analysis/Diagnosis.ps1). Never changes healthScore and never asserts a cause.",
      "required": ["version", "symptom", "conclusion", "questions", "keyFindings"],
      "properties": {
        "version": { "type": "string" },
        "symptom": { "enum": ["general", "boot", "slow", "crash"] },
        "conclusion": { "enum": ["found", "weak", "none", "insufficient"] },
        "coveragePct": { "type": ["number", "null"] },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "answer", "relevance", "confidence", "source", "window"],
            "properties": {
              "id": { "enum": ["cpu_load", "memory_pressure", "storage_busy", "storage_slow", "storage_errors", "storage_health", "boot_history", "crash_history", "process_commit", "process_io", "graphics_events", "storage_signals", "network_ports", "incident_correlation", "graphics_timeout", "wer_failures", "ports_current", "storage_device"] },
              "answer": { "enum": ["yes", "partial", "no", "unknown", "not_collected", "access_denied", "unsupported", "error", "partial_unknown"] },
              "relevance": { "enum": ["high", "medium", "low"] },
              "confidence": { "enum": ["high", "medium", "low"] },
              "window": { "enum": ["observation", "history", "snapshot", "none"] }
            }
          }
        },
        "keyFindings": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": true } },
        "nextSteps": { "type": "array", "items": { "type": "string" } },
        "notVerified": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "incident": {
          "type": "object",
          "additionalProperties": true,
          "description": "Phase A (optional): the reported time against the event catalog. reliability says whether the clock and log retention allow the comparison.",
          "properties": {
            "kind": { "enum": ["at", "during_run"] },
            "reliability": { "enum": ["ok", "no_catalog", "after_run", "clock_future", "clock_step", "retention_unknown", "before_retention", "partial_retention"] },
            "nearCount": { "type": "integer", "minimum": 0 },
            "nearFaults": { "type": "integer", "minimum": 0 }
          }
        },
        "timeline": { "type": "array", "maxItems": 150, "items": { "type": "object", "additionalProperties": true } },
        "correlations": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "storageMap": { "type": "array", "description": "Phase B: \\Device\\HarddiskN from disk events against the current disks.", "items": { "type": "object", "additionalProperties": true, "properties": { "diskNumber": { "type": "integer" }, "mapping": { "enum": ["current_boot", "earlier_boot", "device_absent"] } } } },
        "hypotheses": {
          "type": "array",
          "description": "Phase C: closed hypothesis catalog. untested means it could not be checked and must never be read as likely; not_supported is not the same as ruled out.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "state", "confidence"],
            "properties": {
              "id": { "enum": ["graphics_driver_instability", "application_failures", "storage_path_instability", "disk_saturation", "memory_pressure", "cpu_saturation", "port_exhaustion_active", "port_exhaustion_history", "hardware_error_reported"] },
              "state": { "enum": ["supported", "not_supported", "inconclusive", "untested"] },
              "confidence": { "enum": ["high", "medium", "low"] }
            }
          }
        }
      }
    },
    "investigations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Phases B/C, Full audit: closed catalog of complementary read-only investigations. Each run records why it ran or did not. No address, connection port, command line, path, WER bucket, module or event message is kept.",
      "properties": {
        "version": { "type": "string" },
        "depth": { "enum": ["standard", "deep"] },
        "categories": { "type": "array", "items": { "enum": ["H", "P", "N", "C", "D"] } },
        "budgetMs": { "type": "integer", "minimum": 0, "maximum": 180000 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "budgetExceeded": { "type": "boolean" },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "level", "category", "state"],
            "properties": {
              "id": { "enum": ["gpu_events", "wer_events", "net_ports", "service_hosts", "gpu_use", "storage_reliability", "confirm_peak"] },
              "level": { "enum": [1, 2] },
              "category": { "enum": ["H", "P", "N", "C", "D"] },
              "state": { "enum": ["ok", "empty", "not_triggered", "not_authorized", "budget", "limit", "access_denied", "unsupported", "error"] },
              "elapsedMs": { "type": "integer", "minimum": 0 },
              "truncated": { "type": "boolean" }
            }
          }
        },
        "results": { "type": "object", "additionalProperties": true }
      }
    },
    "advanced": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "Full-mode device, Defender, AV and update metadata plus passive registry inventory. Live Authenticode and Windows Update searches are not collected.",
      "properties": {
        "updates": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": { "const": "not_collected" },
            "justification": { "type": "string" }
          }
        },
        "installedApps": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": { "type": "string" },
            "totalCount": { "type": ["integer", "null"] },
            "presentedCount": { "type": ["integer", "null"] },
            "truncated": { "type": ["boolean", "null"] },
            "collectionTruncated": { "type": ["boolean", "null"] },
            "sanitizedTruncated": { "type": ["boolean", "null"] },
            "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          }
        },
        "signatures": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": { "type": "string" },
            "checked": { "type": ["integer", "null"] },
            "presentedCount": { "type": ["integer", "null"] },
            "truncated": { "type": ["boolean", "null"] },
            "collectionTruncated": { "type": ["boolean", "null"] },
            "sanitizedTruncated": { "type": ["boolean", "null"] },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "file": { "type": ["string", "null"], "description": "Basename only in the sanitized view." },
                  "status": { "type": ["string", "null"], "description": "Authenticode status; NotSigned is NOT evidence of malware." }
                }
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["ok", "partial", "failed"] },
          "durationMs": { "type": ["integer", "null"] },
          "commands": { "type": "array", "items": { "type": "string" }, "description": "Static inventory of read-only commands used by the module." },
          "errors": { "type": "array", "items": { "type": "object" } },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key"],
              "properties": {
                "key": { "type": "string", "description": "Canonical limitation id (may carry a dynamic suffix)." },
                "detail": { "type": "string", "description": "Canonical English detail, kept unchanged." },
                "localeKey": { "type": "string", "description": "Report text key (limit.<localeKey>) when key has a dynamic suffix." },
                "values": { "type": "array", "description": "Values for the {0}.. placeholders of the localized text." }
              }
            }
          }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "subChecks": { "type": "array", "items": {} },
    "analysis": {
      "type": "object",
      "required": ["checks", "findings"],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "state"],
            "properties": {
              "id": { "type": "string" },
              "state": { "enum": ["pass", "finding", "unknown", "unsupported", "access_denied", "not_collected", "error"] },
              "limitations": { "type": "array", "items": { "type": "string" }, "description": "Canonical English text." },
              "limitationKeys": { "type": "array", "items": { "type": "string" }, "description": "Stable locale keys, parallel to limitations ('' when unregistered)." }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "category", "confidence"],
            "properties": {
              "limitations": { "type": "array", "items": { "type": "string" } },
              "limitationKeys": { "type": "array", "items": { "type": "string" } },
              "riskGate": { "enum": ["critical"], "description": "Set only by base rules with a proven critical storage failure." }
            }
          }
        }
      }
    },
    "healthScore": {
      "type": "object",
      "required": ["score", "status", "confidence", "riskLevel", "coveragePct", "coveredChecks", "applicableChecks", "categories"],
      "properties": {
        "scoreAlgorithmVersion": { "type": "string", "description": "Version of the scoring formula (2.0 = eligibility + renormalization + risk gate, FMP-01). Optional so documents from earlier runs stay valid." },
        "score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "uncappedScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "Score before the critical-risk cap." },
        "scoreCap": { "type": ["number", "null"], "description": "Cap in force for this riskLevel (riskGates in rules.json), else null." },
        "capped": { "type": "boolean" },
        "status": { "enum": ["ok", "provisional", "unavailable"], "description": "Availability of the score (coverage), not health." },
        "confidence": { "enum": ["low", "medium", "high"], "description": "Confidence in the collected data, not in the computer's health." },
        "riskLevel": { "enum": ["critical", "elevated", "none_detected", "undetermined"], "description": "Diagnostic risk from base findings, independent of status and confidence." },
        "riskReasons": { "type": "array", "items": { "type": "string" }, "description": "Rule ids behind riskLevel." },
        "coveragePct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "coveredChecks": { "type": "integer", "minimum": 0 },
        "applicableChecks": { "type": "integer", "minimum": 0 },
        "eligibleWeight": { "type": "number", "minimum": 0, "maximum": 100, "description": "Sum of the weights of the categories that entered the score." },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "eligible": { "type": "boolean" },
              "excludedReason": { "enum": ["no_base_rules", "no_evidence", "zero_weight", null] }
            }
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "limitationKeys": { "type": "array", "items": { "type": "string" } }
      },
      "if": { "properties": { "status": { "const": "unavailable" } } },
      "then": { "properties": { "score": { "type": "null" } } },
      "else": { "properties": { "score": { "type": "integer" } } }
    },
    "privacy": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "sanitized": { "type": "boolean" },
        "redactionCount": { "type": "integer" },
        "truncated": { "type": "boolean" },
        "truncatedCollections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "originalCount", "retainedCount"],
            "properties": {
              "path": { "type": "string" },
              "originalCount": { "type": "integer", "minimum": 0 },
              "retainedCount": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
